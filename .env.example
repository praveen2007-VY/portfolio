# Copy to .env.local (never commit .env.local) and fill in your values.
# Supabase dashboard -> Project Settings -> API (Data API / API Keys).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — or the legacy "anon" public key.
# Safe in the browser: Row Level Security enforces all permissions.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL, used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional upload limits in MB (capped by the storage bucket limits: 5 MB images, 10 MB documents).
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_DOCUMENT_MB=10

# Not needed: this app never uses the Supabase service-role key.
# Do NOT add it here or to your hosting provider for this project.

# Optional: end-to-end CMS tests against a staging project (see README).
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_NONADMIN_EMAIL=
# E2E_NONADMIN_PASSWORD=
